{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "macOSPrivateApi": true,
    "trayIcon": {
      "id": "smart-connect-tray",
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": true,
      "showMenuOnLeftClick": false
    },
    "windows": [
      {
        "label": "main",
        "title": "Smart Connect",
        "width": 1180,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 24 }
      }
    ]
  },
  "bundle": {
    "macOS": {
      "infoPlist": "Info.plist"
    }
  }
}
